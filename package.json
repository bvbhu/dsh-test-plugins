{
  "name": "@bvbhu/as-one",
  "version": "0.6.0",
  "description": "As One gateway DSH plugin: multi-account model routing + OpenAI-compatible gateway surface, hooked into the DSH native model picker.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": "./lib/core.js",
    "./subagent": "./lib/subagent.js",
    "./external-port": "./lib/external-port.js",
    "./external-usage": "./lib/external-usage.js",
    "./bot-channel": "./lib/bot-channel.js",
    "./bot-mhy": "./lib/bot-mhy.js",
    "./bot-chat": "./lib/bot-chat.js",
    "./bot-assistant": "./lib/bot-assistant.js",
    "./bot-session-tools": "./lib/bot-session-tools.js",
    "./bot-notify": "./lib/bot-notify.js",
    "./settings": "./lib/settings.js",
    "./channel-trae": "./lib/channel-trae.js",
    "./channel-workbuddy": "./lib/channel-workbuddy.js",
    "./channel-sensenova": "./lib/channel-sensenova.js",
    "./channel-minimax": "./lib/channel-minimax.js",
    "./channel-qoder": "./lib/channel-qoder.js",
    "./channel-codearts": "./lib/channel-codearts.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./core/locale/*.json": "./locale/core/*.json",
    "./subagent/locale/*.json": "./locale/subagent/*.json",
    "./external-port/locale/*.json": "./locale/external-port/*.json",
    "./external-usage/locale/*.json": "./locale/external-usage/*.json",
    "./bot-channel/locale/*.json": "./locale/bot-channel/*.json",
    "./bot-mhy/locale/*.json": "./locale/bot-mhy/*.json",
    "./bot-chat/locale/*.json": "./locale/bot-chat/*.json",
    "./bot-assistant/locale/*.json": "./locale/bot-assistant/*.json",
    "./bot-session-tools/locale/*.json": "./locale/bot-session-tools/*.json",
    "./bot-notify/locale/*.json": "./locale/bot-notify/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "DETAILS.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "node scripts/bundle-host.mjs && node scripts/bundle-client.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.3.0-0",
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvbhu/dsh-as-one.git"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.30",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "ws": "^8.23.0"
  }
}
